{
  "name": "digitalhut-live",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node tools/generate-search-console-row-sitemaps.mjs && vite build && node tools/generate-route-crawl-shells.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "electron electron/main.cjs",
    "desktop:local": "cross-env DIGITALHUT_DESKTOP_LOCAL=1 electron electron/main.cjs",
    "desktop:dir": "npm run build && electron-builder --dir --config electron-builder.json",
    "desktop:pack": "npm run build && electron-builder --win portable --config electron-builder.json",
    "desktop:dist": "npm run build && electron-builder --win nsis portable --config electron-builder.json",
    "preserve": "node tools/preserve-digitalhut.mjs",
    "preserve:local": "node tools/preserve-digitalhut.mjs --base=http://127.0.0.1:4173",
    "preserve:live": "node tools/preserve-digitalhut.mjs --base=https://www.digitalhut.app",
    "preserve:progression": "node tools/progression-runners.mjs",
    "verify:metrics": "node tools/verify-metric-contract.mjs",
    "verify:predeploy": "node tools/verify-metric-contract.mjs && node tools/generate-search-console-row-sitemaps.mjs && vite build && node tools/generate-route-crawl-shells.mjs",
    "verify:cloud": "node tools/verify-metric-contract.mjs && node tools/generate-search-console-row-sitemaps.mjs && vite build && node tools/generate-route-crawl-shells.mjs && node tools/verify-cloud-build-artifacts.mjs",
    "seo:runner": "node tools/firecuda-seo-runner-cycle-002.mjs",
    "seo:active-attempt": "node tools/run-active-client-attempt-cycle.mjs",
    "seo:reevaluate": "node tools/write-seo-structure-reevaluation.mjs",
    "seo:standby": "node tools/codex-standby-runner.mjs",
    "seo:viral": "node tools/digitalhut-viral-source-packet.mjs",
    "seo:resume": "node tools/codex-standby-runner.mjs",
    "system:capabilities": "node tools/codex-standby-runner.mjs",
    "system:viral": "node tools/digitalhut-viral-source-packet.mjs",
    "codex:standby": "node tools/codex-standby-runner.mjs",
    "codex:resume": "node tools/codex-standby-runner.mjs",
    "backend": "node server.js",
    "start": "node server.js",
    "dev:full": "concurrently \"npm run backend\" \"npm run dev -- --host\"",
    "verify:release": "node tools/verify-metric-contract.mjs && node tools/generate-search-console-row-sitemaps.mjs && node tools/digitalhut-release-readiness.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.8.0",
    "@babylonjs/loaders": "^9.8.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@google/model-viewer": "^4.2.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.100.11",
    "axios": "^1.16.1",
    "babylonjs": "^9.8.0",
    "babylonjs-loaders": "^9.8.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "howler": "^2.2.4",
    "phaser": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.15.1",
    "three": "^0.182.0",
    "viem": "^2.50.4",
    "vite-plugin-pwa": "^1.3.0",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "vite": "^8.0.13"
  }
}
