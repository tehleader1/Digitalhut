# DigitalHut environment variable placement
# Copy these names into the active production host for digitalhut.app.
# Do not commit real secret values to this public repository.

# Sketchfab observatory feed
SKETCHFAB_ACCESS_TOKEN=

# Alpaca market feed
# Put your Alpaca key ID after the equals sign.
ALPACA_API_KEY=

# Put your Alpaca secret key after the equals sign.
ALPACA_SECRET_KEY=

# Paper trading endpoint. This value is safe to commit.
APCA_API_BASE_URL=https://paper-api.alpaca.markets/v2

# Supabase persistence
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# DigitalHut payments
DIGITALHUT_PAYMENT_WALLET=
