{
  "version": 2,
  "framework": "vite",
  "devCommand": "npm run dev -- --host 127.0.0.1 --port $PORT",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --legacy-peer-deps",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/overnight-runner",
      "schedule": "0 9 * * *"
    }
  ]
}
